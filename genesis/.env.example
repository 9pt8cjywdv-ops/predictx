# ---------------------------------------------------------------- GENESIS AI configuration
# Copy to .env and fill in. Never commit .env. Never put private keys or seed phrases here.

# Database (docker-compose builds DATABASE_URL from POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me-long-random
# DATABASE_URL=postgresql+psycopg://genesis:password@localhost:5432/genesis   # for non-docker runs

# Dashboard / API access (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
GENESIS_ADMIN_TOKEN=
GENESIS_VIEWER_TOKEN=

# Encryption key for stored integration credentials
# (generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
GENESIS_MASTER_KEY=

# Claude. Without a key, agents use the deterministic heuristic brain (zero API cost).
ANTHROPIC_API_KEY=
# Use real Claude calls during simulation? Costs real money while balances are virtual.
GENESIS_SIM_USE_CLAUDE=false

# Clock / scheduler
# true  = simulated clock (advance from the dashboard or API; scheduler advances 1 sim-hour per second)
# false = real time (scheduler ticks every GENESIS_TICK_SECONDS)
GENESIS_SIM_CLOCK=true
GENESIS_TICK_SECONDS=3600
GENESIS_AUTOSTART=false
GENESIS_SIM_SEED=42

# Live mode prerequisites (awaiting administrator setup):
# URL of the external, policy-enforcing transaction-signing service. Keys live there, never here.
GENESIS_SIGNER_URL=
GENESIS_CORS_ORIGINS=
