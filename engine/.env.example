# --- Required
DATABASE_URL=postgresql+psycopg://predictx:predictx@localhost:5432/predictx

# --- Optional but recommended: market-implied probabilities (https://the-odds-api.com)
ODDS_API_KEY=
ODDS_API_REGIONS=uk,eu

# --- Optional: enables POST /api/admin/refresh (send "Authorization: Bearer <token>")
ADMIN_TOKEN=

# --- Tuning (defaults shown)
HISTORY_DAYS=540
LOOKAHEAD_DAYS=7
FIXTURES_INTERVAL_MIN=30
INJURIES_INTERVAL_MIN=120
ODDS_INTERVAL_MIN=120
STALE_AFTER_HOURS=6
# Comma separated subset of league keys from predictx_engine/leagues.py, e.g. eng.1,nba,nfl
ENABLED_LEAGUES=
