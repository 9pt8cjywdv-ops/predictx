<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>za.bbbee.caddy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BREW__/bin/caddy</string>
    <string>run</string>
    <string>--config</string><string>__DATA_DIR__/Caddyfile</string>
    <string>--adapter</string><string>caddyfile</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__DATA_DIR__/logs/caddy.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIR__/logs/caddy.err.log</string>
</dict>
</plist>
