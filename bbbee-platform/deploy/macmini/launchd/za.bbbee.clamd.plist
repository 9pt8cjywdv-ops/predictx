<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>za.bbbee.clamd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLAMD__</string>
    <string>--foreground</string>
    <string>--config-file=__BREW__/etc/clamav/clamd.conf</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>__DATA_DIR__/logs/clamd.err.log</string>
</dict>
</plist>
