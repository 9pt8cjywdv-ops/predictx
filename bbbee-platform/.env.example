# PostgreSQL (use pgvector/pgvector:pg16 image in production for vector retrieval)
DATABASE_URL="postgresql://bbbee:bbbee@localhost:5432/bbbee?schema=public"

# Session security
SESSION_TTL_HOURS=12
# Set to "true" behind HTTPS
COOKIE_SECURE=false

# Object storage: "local" (dev) or "s3" (S3-compatible: AWS S3, MinIO, Cloudflare R2...)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side encryption for S3 objects: AES256 or aws:kms
S3_SSE=AES256

# Malware scanning (ClamAV clamd). When unset, uploads are quarantined as NOT_SCANNED.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Upload limits
MAX_UPLOAD_BYTES=104857600
MAX_ZIP_ENTRIES=2000
MAX_ZIP_UNCOMPRESSED_BYTES=1073741824

# Anthropic Claude API (verification agents)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
